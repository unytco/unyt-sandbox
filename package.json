{
  "name": "unyt-shipyard",
  "version": "0.0.0",
  "private": true,
  "license": "CAL-1.0",
  "workspaces": [
    "unyt",
    "unyt/ui/white-label"
  ],
  "scripts": {
    "network:tauri": "concurrently \"cd unyt && yarn network:tauri\" \"yarn launch\"",
    "launch": "concurrently \"AGENT_ID=1 CARGO_TARGET_DIR=target/agent1 yarn tauri dev --port 1420\" \"AGENT_ID=2 CARGO_TARGET_DIR=target/agent2 yarn tauri dev --port 1421\"",
    "launch:android": "yarn tauri android dev",
    "tauri": "tauri"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "concurrently-repeat": "^0.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "get-port-cli": "3.0.0"
  },
  "resolutions": {
    "libsodium-wrappers": "0.8"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
